{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "S75 Studio",
  "version": "0.7.0",
  "identifier": "dev.aula.s75studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "S75 Studio",
        "width": 1340,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "backgroundColor": "#141416",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "shortDescription": "Configura\u00e7\u00e3o e diagn\u00f3stico do AULA S75 Pro",
    "category": "Utility"
  }
}
